TZ=Europe/Berlin
# Host-Verzeichnis für pyatv-Pairing und ADB-Schlüssel
DATA_DIR=/srv/atv-projector/data
# IP des Apple TV (feste IP per DHCP-Reservierung)
ATV_HOST=192.168.1.20
# optional: Identifier aus "atvremote scan"
ATV_ID=
# IP:Port des Projektors (ADB über Netzwerk)
PROJECTOR_ADDR=192.168.1.30:5555
OFF_KEYCODE=KEYCODE_POWER
OFF_DELAY=20
POLL_INTERVAL=10
# nach erfolgreichem Test auf false
DRY_RUN=true
LOG_LEVEL=INFO
